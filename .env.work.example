# À renseigner uniquement dans les variables de la stack Portainer du travail.
# Ne pas committer de vrais secrets et NE PAS utiliser la base /data du NAS de test.
STOCKPILOT_IMAGE=ghcr.io/m4ximeg/stockpilot:sha-REMPLACER_PAR_LE_SHA_DU_BUILD_VALIDE
STOCKPILOT_BIND_ADDRESS=127.0.0.1
STOCKPILOT_ADMIN_USERNAME=admin
STOCKPILOT_ADMIN_PASSWORD=REMPLACER_PAR_12_CARACTERES_OU_PLUS
STOCKPILOT_SECRET_KEY=REMPLACER_PAR_UNE_CLE_ALEATOIRE_FORTE
HENRRI_CLIENT_ID=
HENRRI_CLIENT_SECRET=

# Chemin ABSOLU déjà monté sur le serveur de travail vers un AUTRE NAS/disque.
# Docker n'essaiera pas de le créer s'il n'existe pas.
# Le conteneur tourne en UID 10001 : autoriser l'écriture.
STOCKPILOT_EXTERNAL_BACKUP_HOST_PATH=/mnt/nas-sauvegardes/stockpilot
