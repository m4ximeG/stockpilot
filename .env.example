# Copier en .env pour docker compose local ou saisir dans Portainer (variables de la stack)
STOCKPILOT_ADMIN_USERNAME=admin
STOCKPILOT_ADMIN_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT_12_CARACTERES_MINIMUM
STOCKPILOT_SECRET_KEY=REMPLACER_PAR_CLE_ALEATOIRE_DE_64_CARACTERES
STOCKPILOT_DEMO_SEED=1
STOCKPILOT_ALLOW_RESET=0
STOCKPILOT_SECURE_COOKIES=1

# Henrri : clé publique + secret de l'entreprise, uniquement côté serveur
# L'intégration reste inactive tant que les deux clés sont vides.
HENRRI_ENVIRONMENT=sandbox
HENRRI_CLIENT_ID=
HENRRI_CLIENT_SECRET=
